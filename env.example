# Copia este archivo como .env y ajusta los valores.
# Con EXPO_PUBLIC_USE_MOCK=true la app funciona sin Firebase (datos simulados).
EXPO_PUBLIC_USE_MOCK=true

# Estilo vectorial de MapLibre. El demo de MapLibre es solo para pruebas.
EXPO_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
