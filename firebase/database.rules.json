{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "rutas": {
      ".read": "auth != null",
      "$rutaId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && auth.token.firebase.sign_in_provider === 'password' && newData.exists()",
        ".validate": "newData.hasChildren(['nombre', 'linea_id', 'linea_nombre', 'sentido', 'polyline'])",
        "nombre": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
        "linea_id": { ".validate": "newData.isString() && newData.val().length > 0" },
        "linea_nombre": { ".validate": "newData.isString() && newData.val().length > 0" },
        "sentido": { ".validate": "newData.val() === 'ida' || newData.val() === 'vuelta'" },
        "polyline": {
          ".validate": "newData.hasChildren()",
          "$i": {
            ".validate": "newData.hasChildren(['latitude', 'longitude'])",
            "latitude": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
            "longitude": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
            "$other": { ".validate": false }
          }
        },
        "waypoints": {
          ".validate": "newData.hasChildren()",
          "$i": {
            ".validate": "newData.hasChildren(['latitude', 'longitude'])",
            "latitude": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
            "longitude": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
            "$other": { ".validate": false }
          }
        },
        "activa": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },
    "paradas": {
      ".read": "auth != null",
      "$paradaId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && auth.token.firebase.sign_in_provider === 'password'",
        ".validate": "newData.hasChildren(['ruta_id', 'nombre', 'lat', 'lng', 'orden']) && newData.child('ruta_id').isString() && newData.child('ruta_id').val().length > 0 && !newData.child('ruta_id').val().contains('/') && newData.parent().parent().child('rutas').child(newData.child('ruta_id').val()).exists()",
        "ruta_id": { ".validate": "newData.isString()" },
        "nombre": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
        "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "orden": { ".validate": "newData.isNumber() && newData.val() >= 1" },
        "$other": { ".validate": false }
      }
    },
    "vehiculos_activos": {
      ".read": "auth != null",
      "$vehiculoId": {
        ".write": "auth != null && auth.uid === $vehiculoId && root.child('usuarios').child(auth.uid).child('consentimiento').child('aceptado').val() === true",
        ".validate": "newData.hasChildren(['lat', 'lng', 'timestamp_ultima_actualizacion', 'ruta_activa', 'velocidad_actual', 'en_servicio'])",
        "lat": { ".validate": "newData.isNumber()" },
        "lng": { ".validate": "newData.isNumber()" },
        "timestamp_ultima_actualizacion": { ".validate": "newData.isNumber()" },
        "ruta_activa": { ".validate": "newData.isString()" },
        "velocidad_actual": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "en_servicio": { ".validate": "newData.isBoolean()" }
      }
    },
    "usuarios": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "metricas": {
      ".read": false,
      "$metricaId": {
        ".write": "auth != null && !data.exists()"
      }
    }
  }
}
